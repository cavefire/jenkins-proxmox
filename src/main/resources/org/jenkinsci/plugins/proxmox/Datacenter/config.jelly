<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">

    <f:entry title="${%Hostname}" field="hostname" help="/plugin/proxmox/help-datacenter-hostname.html"
             description="${%One or more hosts of the cluster, as host or host:port, separated by commas. The API fails over between them.}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Username}" field="username" help="/plugin/proxmox/help-datacenter-username.html">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Realm}" field="realm" help="/plugin/proxmox/help-datacenter-realm.html">
        <f:textbox default="pve" />
    </f:entry>

    <f:entry title="${%Password}" field="password" help="/plugin/proxmox/help-datacenter-password.html">
        <f:password />
    </f:entry>

    <f:advanced>
        <f:entry title="${%Ignore SSL certificates}" field="ignoreSSL">
            <f:checkbox default="false" />
        </f:entry>
    </f:advanced>

    <f:entry title="${%SSH credentials for the Proxmox hosts}" field="sshCredentialsId"
             description="${%When set, Jenkins only uses SSH on port 22 to the hosts: the API is tunneled through it, and clones are reached through the host running them. Empty connects directly.}">
        <c:select />
    </f:entry>
    <f:advanced title="${%SSH port}">
        <f:entry title="${%SSH port of the Proxmox hosts}" field="sshPort">
            <f:number default="22" min="1" max="65535" />
        </f:entry>
    </f:advanced>

    <f:validateButton title="${%Test Connection}" progress="${%Testing...}" method="testConnection"
                      with="hostname,username,realm,password,ignoreSSL,sshCredentialsId,sshPort"/>

    <f:section title="${%Agents from templates}">
        <f:entry title="${%SSH credentials for clones}" field="guestCredentialsId" help="/plugin/proxmox/help-datacenter-templates.html"
                 description="${%Default; a template can override it with a jenkins-credentials line in its notes.}">
            <c:select />
        </f:entry>
        <f:entry title="${%Agent directory in clones}" field="agentRemoteFS"
                 description="${%Default; override with jenkins-remote-fs in the template notes, e.g. C:\jenkins.}">
            <f:textbox default="/home/jenkins/agent" />
        </f:entry>
        <f:entry title="${%Java in clones}" field="javaPath"
                 description="${%Default; empty looks for java on the PATH. Override with jenkins-java in the template notes.}">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Instance cap}" field="instanceCap">
            <f:number default="10" min="1" />
        </f:entry>
        <f:advanced>
            <f:entry title="${%Full clone}" field="fullClone"
                     description="${%Linked clones are faster; full clones do not depend on the template's disks.}">
                <f:checkbox />
            </f:entry>
            <f:entry title="${%Storage for full clones}" field="cloneStorage">
                <f:textbox />
            </f:entry>
            <f:entry title="${%First VM ID for clones}" field="firstVmid"
                     description="${%Clones get the lowest free ID from here on, e.g. 10000. Empty or 0 uses the next free ID Proxmox suggests.}">
                <f:number min="0" />
            </f:entry>
            <f:entry title="${%Startup timeout (seconds)}" field="startupTimeoutSeconds"
                     description="${%Time from clone start until the agent must be connected.}">
                <f:number default="600" min="1" />
            </f:entry>
        </f:advanced>
        <f:validateButton title="${%Test provisioning}" progress="${%Testing...}" method="testProvisioning"
                          with="hostname,username,realm,password,ignoreSSL,guestCredentialsId,agentRemoteFS,javaPath,sshCredentialsId,sshPort"/>
    </f:section>

</j:jelly>
